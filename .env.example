ANTHROPIC_API_KEY=sk-ant-api03-...your-key-here...

# Supabase project (from Supabase → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# Optional — only needed if Claude Code (or another tool) runs migrations
# directly against your Supabase project on your behalf. Generate at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...personal-access-token...
SUPABASE_PROJECT_REF=your-project-id

# Optional — admin app password gate
APP_PASSWORD=pick-anything

# Optional — base URL for the public deal-link share button. Defaults to
# http://localhost:8501 for local dev. Set this to your deployed app URL
# (e.g. https://vc-thesis-assistant-xxxx.streamlit.app) so share links
# point at the live site.
APP_PUBLIC_URL=https://your-app.streamlit.app
